{
  "ffmpeg_path": "ffmpeg",
  "output_dir": "recordings",
  "runtime_dir": ".runtime",
  "fps": 60,
  "bitrate": "20M",
  "max_bitrate": "25M",
  "buffer_size": "40M",
  "encoder": "auto",
  "encoder_preset": "p1",
  "capture_mode": "window",
  "recording_mode": "highlights",
  "review_after_match": true,
  "delete_to_recycle_bin": true,
  "recording_events": ["kill", "multikill_2", "multikill_3", "multikill_4", "multikill_5", "first_blood", "ace", "dragonkill", "heraldkill", "baronkill", "turretkilled", "inhibkilled"],
  "show_event_notifications": true,
  "event_notification_style": "pulse",
  "disk_quota_gb": 50,
  "minimum_free_gb": 5,
  "audio_enabled": true,
  "microphone_enabled": false,
  "separate_audio_tracks": true,
  "audio_bitrate": "192k",
  "audio_output_channels": 2,
  "pre_roll_seconds": 45,
  "post_roll_seconds": 15,
  "poll_interval_seconds": 0.1,
  "telemetry_interval_seconds": 0.1,
  "embed_telemetry_footer": true,
  "segment_seconds": 1,
  "segment_grace_seconds": 2,
  "memory_buffer_mb": 512,
  "audio_capture_mode": "process_loopback"
}
