root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning

[*.{csproj,json}]
indent_style = space
indent_size = 2

[*.xaml]
indent_style = space
indent_size = 4

[*.{cmd,ps1}]
end_of_line = crlf
