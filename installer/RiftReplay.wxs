<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Rift Replay" Manufacturer="Rift Replay" Version="$(ProductVersion)"
           UpgradeCode="5BD8D5CB-9464-46EA-B4CE-0E6300A06939" Scope="perMachine">
    <MajorUpgrade AllowSameVersionUpgrades="yes" IgnoreLanguage="yes" DowngradeErrorMessage="A newer version of Rift Replay is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="RiftReplay.exe" SourceFile="!(bindpath.Publish)\LolHighlight.Desktop.exe" />
    <Property Id="ARPPRODUCTICON" Value="RiftReplay.exe" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <!-- Skip the stock placeholder license page on both forward and back navigation. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="NOT Installed" Order="10" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="10" />
    </UI>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Rift Replay" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="App" Title="Rift Replay">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Publish)\**">
        <Exclude Files="!(bindpath.Publish)\LolHighlight.Desktop.exe" />
      </Files>
      <Component Id="MainProgram">
        <File Id="AppExe" Source="!(bindpath.Publish)\LolHighlight.Desktop.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Rift Replay"
                    WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="RiftReplay.exe" IconIndex="0" />
        </File>
      </Component>
      <Component Id="InstalledMode">
        <File Source="!(bindpath.Installer)\installed-mode" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
