<UserControl x:Class="LolHighlight.Desktop.Controls.SettingSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Spacing="4">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource LabelTextStyle}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="ValueText" Grid.Column="1" Style="{StaticResource MetaTextStyle}"
                       VerticalAlignment="Center"/>
        </Grid>
        <Slider x:Name="ValueSlider" MinHeight="32" HorizontalAlignment="Stretch"
                IsThumbToolTipEnabled="False" ValueChanged="Slider_ValueChanged"
                PreviewKeyDown="Slider_KeyDown" AutomationProperties.Name="{Binding Label, ElementName=Root}"
                AutomationProperties.HelpText="{Binding HelpText, ElementName=Root}"/>
        <TextBlock x:Name="RangeText" TextWrapping="Wrap" Style="{StaticResource MetaTextStyle}"/>
        <TextBlock x:Name="LegacyValueText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{StaticResource WarningBrush}"/>
        <TextBlock Text="{Binding HelpText, ElementName=Root}" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
