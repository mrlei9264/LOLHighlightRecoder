<UserControl x:Class="LolHighlight.Desktop.Views.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:LolHighlight.Desktop.Controls">
 <Grid Padding="20" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid RowSpacing="8" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBox x:Name="SearchBox" Text="{Binding SearchQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索录像" AutomationProperties.Name="搜索录像"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding EventFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EventFilter,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="事件筛选"/>
   <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SortOrder,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="排序"/>
   <Button Grid.Column="3" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新录像"><FontIcon Glyph="&#xE72C;" FontSize="15"/></Button>
   <CalendarDatePicker x:Name="FromDate" Grid.Row="1" Grid.ColumnSpan="2" DateChanged="Date_Changed" PlaceholderText="起始日期" HorizontalAlignment="Stretch" DateFormat="{}{year.full}/{month.integer}/{day.integer}" AutomationProperties.Name="起始日期"/>
   <CalendarDatePicker x:Name="ToDate" Grid.Row="1" Grid.Column="2" DateChanged="Date_Changed" PlaceholderText="结束日期" HorizontalAlignment="Stretch" DateFormat="{}{year.full}/{month.integer}/{day.integer}" AutomationProperties.Name="结束日期"/>
   <Button Grid.Row="1" Grid.Column="3" Content="清除" Click="ClearFilters_Click"/>
  </Grid>
  <Grid Grid.Row="1">
   <GridView x:Name="VideoList" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard,Mode=TwoWay}" SelectionMode="Single" Background="Transparent" BorderThickness="0" SizeChanged="Gallery_SizeChanged" AutomationProperties.Name="录像缩略图">
    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></GridView.ItemContainerStyle>
    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="264" ItemHeight="235"/></ItemsPanelTemplate></GridView.ItemsPanel>
    <GridView.ItemTemplate><DataTemplate>
     <Grid Margin="4" Padding="8" RowSpacing="7" Background="{StaticResource SurfaceBrush}" CornerRadius="8" PointerEntered="Card_Entered" PointerExited="Card_Exited" RightTapped="Video_RightTapped">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Background="#080808" CornerRadius="5">
       <FontIcon Glyph="&#xE714;" FontSize="20" Foreground="{StaticResource TertiaryTextBrush}"/>
       <Image Stretch="Uniform" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" DataContextChanged="Poster_DataContextChanged"/>
       <Button x:Name="PlayOverlay" Opacity="0" Click="Play_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Width="52" Height="52" CornerRadius="26" Background="#CC151515" AutomationProperties.Name="播放录像"><FontIcon Glyph="&#xE768;" FontSize="24"/></Button>
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Row="2" Text="{Binding TagText}" FontSize="11" Foreground="{StaticResource AccentLimeBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding TagText}"/>
      <TextBlock Grid.Row="3" Text="{Binding Meta}" FontSize="10" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis"/>
     </Grid>
    </DataTemplate></GridView.ItemTemplate>
   </GridView>
   <TextBlock x:Name="EmptyLibrary" Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" Foreground="{StaticResource SecondaryTextBrush}" Visibility="{Binding HasVideos,Converter={StaticResource BoolToVisibilityConverter},ConverterParameter=Invert}"/>
   <Grid x:Name="PlaybackLayout" Visibility="Collapsed" ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="72*"/><ColumnDefinition Width="28*"/></Grid.ColumnDefinitions>
    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Background="Black" CornerRadius="8"><controls:MediaPreview x:Name="PreviewPlayer" AutomationProperties.Name="录像播放器"/></Grid>
     <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Content="返回" Click="Back_Click" ToolTipService.ToolTip="Esc 返回视频库"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="PlayingTitle" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlayingTags" FontSize="11" Foreground="{StaticResource AccentLimeBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
    </Grid>
    <ListView x:Name="PlaybackList" Grid.Column="1" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard,Mode=TwoWay}" IsItemClickEnabled="True" ItemClick="PlaybackList_ItemClick" SelectionMode="Single" Background="Transparent" AutomationProperties.Name="播放列表">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate><Grid Padding="4,10" RowSpacing="5" Background="Transparent" RightTapped="Video_RightTapped"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Row="1" Text="{Binding TagText}" FontSize="11" Foreground="{StaticResource AccentLimeBrush}" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="2" Text="{Binding Meta}" FontSize="10" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis"/>
     </Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Grid>
  </Grid>
  <InfoBar Grid.Row="2" IsOpen="{Binding HasStatusMessage,Mode=OneWay}" Message="{Binding StatusMessage}" Severity="{Binding IsStatusError,Converter={StaticResource BoolToInfoBarSeverityConverter}}" Closed="StatusInfoBar_Closed"/>
 </Grid>
</UserControl>
