<UserControl x:Class="LolHighlight.Desktop.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LolHighlight.Desktop.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="VideoRowTemplate">
            <Border Style="{StaticResource ListRowDividerStyle}" Background="Transparent" RightTapped="Video_RightTapped">
                <Grid Padding="10,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <CheckBox MinWidth="0" IsChecked="{Binding IsMarked,Mode=TwoWay}"
                              Visibility="{Binding ShowSelection,Converter={StaticResource BoolToVisibilityConverter}}"
                              AutomationProperties.Name="{Binding Title}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding FileName}" />
                        <TextBlock Text="{Binding TagText}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding TagText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Meta}" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="168" />
                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Background="Transparent" BorderThickness="0"
                            Click="VideoMenu_Click" ToolTipService.ToolTip="录像操作" AutomationProperties.Name="录像操作">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="BrowseToolbar" Spacing="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="视频库" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource MetaTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <ToggleButton x:Name="ListMode" Click="ViewMode_Click" Height="34" ToolTipService.ToolTip="切换卡片与列表"
                                  AutomationProperties.Name="列表视图">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xEA37;" FontSize="14" /><TextBlock Text="列表" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton Content="多选" IsChecked="{Binding MultiSelect,Mode=TwoWay}" Height="34" />
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RefreshCommand}"
                            ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新录像">
                        <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinHeight="34"
                         PlaceholderText="搜索录像" AutomationProperties.Name="搜索录像" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding EventFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding EventFilter,Mode=TwoWay}" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="事件筛选" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding DatePresets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding DatePreset,Mode=TwoWay}" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="日期筛选" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding SortOrder,Mode=TwoWay}" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="排序" />
                <Button Grid.Column="4" Content="清除" Click="ClearFilters_Click" Height="34" AutomationProperties.Name="清除搜索和筛选" />
            </Grid>
            <Border Style="{StaticResource CardBorderStyle}" Padding="10,6"
                    Visibility="{Binding MultiSelect,Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Text="{Binding SelectionText}" Style="{StaticResource LabelTextStyle}" />
                    <Button Content="全选" Click="SelectAll_Click" />
                    <Button Content="清除选择" Click="ClearSelection_Click" IsEnabled="{Binding HasMarkedVideos}" />
                    <Button Content="批量调色" Click="GradeSelected_Click" IsEnabled="{Binding HasMarkedVideos}" />
                    <Button Click="DeleteMarked_Click" IsEnabled="{Binding HasMarkedVideos}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="删除所选" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <GridView x:Name="VideoList" ItemsSource="{Binding Cards}" SelectionMode="None"
                      Background="Transparent" BorderThickness="0" SizeChanged="Gallery_SizeChanged" AutomationProperties.Name="录像缩略图">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="260" ItemHeight="232" /></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4" Style="{StaticResource CardBorderStyle}" RightTapped="Video_RightTapped">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Background="{StaticResource PreviewSurfaceBrush}">
                                    <FontIcon Glyph="&#xE714;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Image Stretch="UniformToFill" Loaded="Poster_Loaded" Unloaded="Poster_Unloaded" DataContextChanged="Poster_DataContextChanged" />
                                    <Button Click="Play_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="8" Width="38" Height="34" Padding="0" Background="#E6222222"
                                            AutomationProperties.Name="播放录像" ToolTipService.ToolTip="播放">
                                        <FontIcon Glyph="&#xE768;" FontSize="15" />
                                    </Button>
                                    <CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="4" MinWidth="0" MinHeight="0"
                                              Background="#E6222222" CornerRadius="6" IsChecked="{Binding IsMarked,Mode=TwoWay}"
                                              Visibility="{Binding ShowSelection,Converter={StaticResource BoolToVisibilityConverter}}"
                                              AutomationProperties.Name="{Binding Title}" />
                                </Grid>
                                <Grid Grid.Row="1" Padding="10,8" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TagText}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding TagText}" />
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding FileName}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top"
                                            Background="Transparent" BorderThickness="0" Click="VideoMenu_Click"
                                            ToolTipService.ToolTip="录像操作" AutomationProperties.Name="录像操作">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <Border x:Name="VideoRowsPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <ListView x:Name="VideoRows" ItemsSource="{Binding Cards}" IsItemClickEnabled="True" ItemClick="PlaybackList_ItemClick"
                          SelectionMode="None" Background="Transparent" ItemContainerStyle="{StaticResource VideoListItemStyle}"
                          ItemTemplate="{StaticResource VideoRowTemplate}" AutomationProperties.Name="录像列表" />
            </Border>
            <StackPanel x:Name="EmptyLibrary" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False">
                <FontIcon Glyph="&#xE8F1;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource SectionTitleTextStyle}" TextAlignment="Center" />
            </StackPanel>

            <Grid x:Name="PlaybackLayout" Visibility="Collapsed" ColumnSpacing="14" SizeChanged="PlaybackLayout_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="73*" /><ColumnDefinition x:Name="PlaybackSidebarColumn" Width="27*" MinWidth="230" /></Grid.ColumnDefinitions>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="PlayingTitle" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="PlayingTags" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="PlaylistToggle" Grid.Column="1" Content="播放列表" Click="PlaylistToggle_Click" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="1" Background="Black" CornerRadius="8" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1">
                        <Grid>
                            <controls:MediaPreview x:Name="PreviewPlayer" ControlsBelowVideo="True" AutomationProperties.Name="录像播放器" />
                            <Button Click="Back_Click" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Width="38" Height="36"
                                    Padding="0" Background="#E6222222" ToolTipService.ToolTip="返回视频库 (Esc)" AutomationProperties.Name="返回视频库">
                                <FontIcon Glyph="&#xE72B;" FontSize="16" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
                <Border x:Name="PlaybackSidebar" Grid.Column="1" Style="{StaticResource QuietPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Spacing="8" Margin="0,0,0,10">
                                <TextBlock Text="播放列表" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource MetaTextStyle}" />
                                <TextBox Text="{Binding SearchQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="搜索录像" AutomationProperties.Name="搜索播放列表" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding EventFilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding EventFilter,Mode=TwoWay}" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="播放列表事件筛选" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DatePresets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding DatePreset,Mode=TwoWay}" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="播放列表日期筛选" />
                                </Grid>
                            </StackPanel>
                        <ListView x:Name="PlaybackList" Grid.Row="1" ItemsSource="{Binding Cards}" IsItemClickEnabled="True"
                                  ItemClick="PlaybackList_ItemClick" SelectionMode="Single" Background="Transparent"
                                  ItemContainerStyle="{StaticResource VideoListItemStyle}" AutomationProperties.Name="播放列表">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRowDividerStyle}" Background="Transparent" RightTapped="Video_RightTapped">
                                        <Grid Padding="8,8" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TagText}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding TagText}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="Transparent" BorderThickness="0"
                                                    Click="VideoMenu_Click" ToolTipService.ToolTip="录像操作" AutomationProperties.Name="录像操作">
                                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="PlaybackEmpty" Grid.Row="1" Text="{Binding EmptyText}" TextWrapping="Wrap"
                                   Style="{StaticResource MetaTextStyle}" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <InfoBar Grid.Row="2" IsOpen="{Binding HasStatusMessage,Mode=OneWay}" Message="{Binding StatusMessage}"
                 Severity="{Binding IsStatusError,Converter={StaticResource BoolToInfoBarSeverityConverter}}" Closed="StatusInfoBar_Closed" />
    </Grid>
</UserControl>
