<UserControl x:Class="LolHighlight.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LolHighlight.Desktop.Controls">
  <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="2">
      <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="管理录制画质、音频、高光规则和存储。" Style="{StaticResource MetaTextStyle}" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="136" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top" Padding="4">
        <ListView x:Name="Categories" SelectionChanged="Category_Changed"
                  ItemContainerStyle="{StaticResource VideoListItemStyle}" AutomationProperties.Name="设置分类">
              <ListViewItem>
                <Border Style="{StaticResource ListRowDividerStyle}" Padding="9,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                    <TextBlock Text="画面" />
                  </StackPanel>
                </Border>
              </ListViewItem>
              <ListViewItem>
                <Border Style="{StaticResource ListRowDividerStyle}" Padding="9,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE767;" FontSize="16" />
                    <TextBlock Text="声音" />
                  </StackPanel>
                </Border>
              </ListViewItem>
              <ListViewItem>
                <Border Style="{StaticResource ListRowDividerStyle}" Padding="9,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE734;" FontSize="16" />
                    <TextBlock Text="高光规则" />
                  </StackPanel>
                </Border>
              </ListViewItem>
              <ListViewItem>
                <Border Style="{StaticResource ListRowDividerStyle}" Padding="9,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    <TextBlock Text="存储" />
                  </StackPanel>
                </Border>
              </ListViewItem>
              <ListViewItem>
                <Border Style="{StaticResource ListRowDividerStyle}" Padding="9,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9F9;" FontSize="16" />
                    <TextBlock Text="对局数据" />
                  </StackPanel>
                </Border>
              </ListViewItem>
              <ListViewItem>
                <Border Style="{StaticResource ListRowDividerStyle}" Padding="9,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE943;" FontSize="16" />
                    <TextBlock Text="编码程序" />
                  </StackPanel>
                </Border>
              </ListViewItem>
        </ListView>
      </Border>
      <ScrollViewer Grid.Column="1" x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="10" Padding="0,0,6,0">
          <StackPanel x:Name="Category0" Spacing="16" Visibility="Visible">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="16">
                <TextBlock Text="录制方式" Style="{StaticResource SectionTitleTextStyle}" />
                <Grid ColumnSpacing="18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="7">
                    <TextBlock Text="录制模式" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox SelectedValue="{Binding RecordingMode, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="选择录制模式">
                      <ComboBoxItem Content="事件高光" Tag="highlights" />
                      <ComboBoxItem Content="整局录制" Tag="full_game" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="7">
                    <TextBlock Text="画面来源" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="LOL 游戏窗口" FontSize="13" Margin="0,8" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding CaptureModeHint}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Text="整局模式持续写入 MP4，不依赖事件或回溯缓存；对局结束或手动停止时完成保存。中途启动只能保存启动后的内容。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TertiaryTextBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="14">
                <TextBlock Text="画质与编码" Style="{StaticResource SectionTitleTextStyle}" />
                <StackPanel Spacing="7">
                  <TextBlock Text="编码器" Style="{StaticResource LabelTextStyle}" />
                  <ComboBox SelectedValue="{Binding Encoder, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="选择视频编码器">
                    <ComboBoxItem Content="自动选择 · 推荐" Tag="auto" />
                    <ComboBoxItem Content="NVIDIA NVENC" Tag="nvenc" />
                    <ComboBoxItem Content="AMD AMF" Tag="amf" />
                    <ComboBoxItem Content="Intel QSV" Tag="qsv" />
                    <ComboBoxItem Content="软件 x264" Tag="x264" />
                  </ComboBox>
                </StackPanel>
                <Grid ColumnSpacing="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:SettingSlider Label="录制帧率" Value="{Binding FpsValue, Mode=TwoWay}" Minimum="30" Maximum="240" Stops="30,60,120,144,165,240" Unit="FPS" HelpText="" />
                  <controls:SettingSlider Label="目标视频码率" Value="{Binding VideoBitrateMbps, Mode=TwoWay}" Minimum="2" Maximum="60" Step="1" Unit="Mbps" Grid.Column="1" HelpText="常用 8～25 Mbps；高分辨率或高帧率可适当提高。" />
                </Grid>
                <Grid ColumnSpacing="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:SettingSlider Label="最大视频码率" Value="{Binding MaxBitrateMbps, Mode=TwoWay}" Minimum="{Binding VideoBitrateMbps}" Maximum="80" Step="1" Unit="Mbps" HelpText="不低于目标码率。" />
                  <controls:SettingSlider Label="码率缓冲大小" Value="{Binding RateBufferMegabits, Mode=TwoWay}" Minimum="4" Maximum="160" Step="2" Unit="Mb" Grid.Column="1" HelpText="通常设为目标码率的 1～2 倍，用于平滑码率波动。" />
                </Grid>
                <TextBlock Text="{Binding SizeEstimate}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="Category1" Spacing="16" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="16">
                <TextBlock Text="音频来源" Style="{StaticResource SectionTitleTextStyle}" />
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="4">
                    <TextBlock Text="游戏声音" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="录制 LOL 进程声音。" FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsOn="{Binding AudioEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="录制游戏声音" />
                </Grid>
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="4">
                    <TextBlock Text="麦克风" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="可独立开启，使用 Windows 默认录音设备。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TertiaryTextBrush}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsOn="{Binding MicrophoneEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="录制麦克风" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="8">
                <StackPanel Spacing="7">
                  <TextBlock Text="音轨模式" Style="{StaticResource LabelTextStyle}" />
                  <ComboBox ItemsSource="{Binding AudioTrackOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SeparateAudioTracks, Mode=TwoWay}" IsEnabled="{Binding CanSeparateAudioTracks}" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="选择音轨模式" />
                  <TextBlock Text="同时开启游戏声音与麦克风时，可以选择分轨或混音。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TertiaryTextBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="Category2" Spacing="16" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="14">
                <TextBlock Text="事件高光" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="仅下方勾选的事件会触发高光。整局录制模式忽略这些筛选条件和片段时长。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                <ContentControl IsEnabled="{Binding IsHighlightMode}" HorizontalContentAlignment="Stretch">
                  <ItemsRepeater ItemsSource="{Binding RecordingEvents}">
                    <ItemsRepeater.Layout>
                      <UniformGridLayout MinItemWidth="160" MinItemHeight="36" MaximumRowsOrColumns="2" ItemsStretch="Fill" Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource ListRowDividerStyle}" Margin="0,2,8,2">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" />
                          </CheckBox>
                        </Border>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </ContentControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="14">
                <TextBlock Text="片段时长" Style="{StaticResource SectionTitleTextStyle}" />
                <ContentControl IsEnabled="{Binding IsHighlightMode}" HorizontalContentAlignment="Stretch">
                  <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:SettingSlider Label="事件前保留" Value="{Binding PreRoll, Mode=TwoWay}" Minimum="0" Maximum="120" Step="5" Unit="秒" HelpText="" />
                    <controls:SettingSlider Label="事件后保留" Value="{Binding PostRoll, Mode=TwoWay}" Minimum="0" Maximum="60" Step="5" Unit="秒" Grid.Column="1" HelpText="" />
                    <controls:SettingSlider Label="导出宽限时间" Value="{Binding SegmentGrace, Mode=TwoWay}" Minimum="1" Maximum="5" Step="1" Unit="秒" Grid.Column="2" HelpText="建议至少 2 秒，等待视频分段完成。" />
                  </Grid>
                </ContentControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="14">
                <TextBlock Text="事件提示" Style="{StaticResource SectionTitleTextStyle}" />
                <ToggleSwitch Header="右上角事件提示" IsOn="{Binding ShowEventNotifications, Mode=TwoWay}" OnContent="开启" OffContent="关闭" AutomationProperties.Name="显示游戏事件提示" />
                <StackPanel Spacing="7">
                  <TextBlock Text="事件提示样式" Style="{StaticResource LabelTextStyle}" />
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding EventNotificationStyleOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding EventNotificationStyle, Mode=TwoWay}" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="选择事件提示样式" />
                    <Button Grid.Column="1" Content="预览提示" Click="PreviewNotification_Click" MinHeight="34" AutomationProperties.Name="预览当前选择的事件提示样式" />
                  </Grid>
                  <TextBlock Text="{Binding EventNotificationStyleDescription}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                  <TextBlock Text="预览不会触发录像；样式修改后自动保存。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TertiaryTextBrush}" />
                  <InfoBar x:Name="NotificationPreviewFeedback" IsOpen="False" Severity="Warning" IsClosable="True" Title="无法显示预览" Message="事件提示窗口暂不可用，请查看运行日志；录像功能继续正常工作。" />
                </StackPanel>
                <TextBlock Text="提示不抢焦点、不进入录像，也不会中断当前文件；无法启用采集排除时不显示提示。独占全屏下系统可能无法显示提示，建议使用无边框。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TertiaryTextBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="Category3" Spacing="16" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="保存位置" Style="{StaticResource SectionTitleTextStyle}" />
                  <TextBlock Text="可选择任意录像目录。" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding OutputPathPreview, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource RecorderTextBoxStyle}" ToolTipService.ToolTip="{Binding OutputPathPreview}" AutomationProperties.Name="录像保存位置（只读）" AutomationProperties.HelpText="点击选择文件夹修改，可选择任意位置，也可选中路径进行复制" />
                  <Button Grid.Column="1" Content="选择文件夹…" Command="{Binding SelectOutputFolderCommand}" IsEnabled="{Binding CanEditPaths}" MinHeight="34" AutomationProperties.Name="选择录像保存文件夹" />
                  <Button Grid.Column="2" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource IconButtonStyle}" IsEnabled="{Binding CanEditPaths}" ToolTipService.ToolTip="打开当前文件夹" AutomationProperties.Name="打开录像文件夹">
                    <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="15" />
                  </Button>
                </Grid>
                <ToggleSwitch Header="对局结束后确认保存" IsOn="{Binding ReviewAfterMatch,Mode=TwoWay}" ToolTipService.ToolTip="预览并勾选保留的录像；关闭后自动保存。" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                  <TextBlock Text="删除到回收站" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="仅用于视频库手动删除。关闭后，确认删除的录像将永久移除。"
                             Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsOn="{Binding DeleteToRecycleBin,Mode=TwoWay}" OnContent="" OffContent=""
                              VerticalAlignment="Center" AutomationProperties.Name="删除到回收站" />
              </Grid>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="16">
                <TextBlock Text="缓存与存储" Style="{StaticResource SectionTitleTextStyle}" />
                <Grid ColumnSpacing="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:SettingSlider Label="视频缓存上限" Value="{Binding MemoryBufferValue, Mode=TwoWay}" Minimum="128" Maximum="4096" Stops="128,256,512,1024,2048,4096" Unit="MB" HelpText="仅限制视频缓存；整局模式自动使用较小的流缓冲。" />
                </Grid>
                <InfoBar IsOpen="{Binding HasMemoryBudgetWarning, Mode=OneWay}" Severity="Warning" IsClosable="False" Title="缓存容量提示" Message="{Binding MemoryBudgetWarning}" />
                <Grid ColumnSpacing="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:SettingSlider Label="录像空间上限" Value="{Binding DiskQuotaValue, Mode=TwoWay}" Minimum="10" Maximum="500" Stops="10,20,50,100,200,500" Unit="GB" HelpText="" />
                  <controls:SettingSlider Label="磁盘至少保留" Value="{Binding MinimumFreeValue, Mode=TwoWay}" Minimum="2" Maximum="50" Stops="2,5,10,20,50" Unit="GB" Grid.Column="1" HelpText="" />
                </Grid>
                <TextBlock Text="空间不足时清理最旧录像，保留正在录制的文件。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TertiaryTextBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="Category4" Spacing="16" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="16">
                <TextBlock Text="对局数据" Style="{StaticResource SectionTitleTextStyle}" />
                <Grid ColumnSpacing="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:SettingSlider Label="数据采集间隔" Value="{Binding TelemetryIntervalMilliseconds, Mode=TwoWay}" Minimum="100" Maximum="1000" Stops="100,200,500,1000" Unit="ms" HelpText="接口响应变慢时，实际采集频率会降低。" />
                </Grid>
                <TextBlock Text="只读访问 Riot 本地接口，不并发堆积请求。Riot 未提供特定请求频率的免封号保证。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TertiaryTextBrush}" />
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="4">
                    <TextBlock Text="保存对局数据" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="将接口原始字段和事件按时间保存为 MP4 内的分块压缩数据，保留未知的新字段。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TertiaryTextBrush}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsOn="{Binding EmbedTelemetryFooter, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="在录像中保存对局数据" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="Category5" Spacing="16" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
              <StackPanel Spacing="16">
                <TextBlock Text="编码程序" Style="{StaticResource SectionTitleTextStyle}" />
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="4">
                    <TextBlock Text="使用自定义 FFmpeg" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="默认使用随附版本，按需选择其他支持窗口采集的 FFmpeg 程序。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TertiaryTextBrush}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsOn="{Binding UseCustomFfmpeg, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="使用自定义 FFmpeg 程序" />
                </Grid>
                <Grid ColumnSpacing="8" Visibility="{Binding UseCustomFfmpeg, Converter={StaticResource BoolToVisibilityConverter}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding FfmpegPath, Mode=OneWay}" IsReadOnly="True" PlaceholderText="请选择 FFmpeg 可执行文件" Style="{StaticResource RecorderTextBoxStyle}" ToolTipService.ToolTip="{Binding FfmpegPath}" AutomationProperties.Name="自定义 FFmpeg 路径（只读）" />
                  <Button Grid.Column="1" Content="选择程序…" Command="{Binding SelectFfmpegCommand}" IsEnabled="{Binding CanEditPaths}" MinHeight="34" AutomationProperties.Name="选择 FFmpeg 可执行程序" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10,6">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding SettingsStateText}" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Button Grid.Column="1" Content="恢复默认设置" Command="{Binding ResetCommand}" />
      </Grid>
    </Border>
    <InfoBar x:Name="SaveToast" Grid.Row="1" IsOpen="False" Message="{Binding SaveMessage}"
             Severity="{Binding SaveFailed,Converter={StaticResource BoolToInfoBarSeverityConverter}}"
             IsClosable="True" HorizontalAlignment="Right" VerticalAlignment="Top"
             MaxWidth="420" Margin="0,0,8,0" CornerRadius="8" AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
