<UserControl x:Class="LolHighlight.Desktop.Views.HomePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="24" ColumnSpacing="24" RowSpacing="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Grid RowSpacing="18">
   <Grid.RowDefinitions><RowDefinition Height="7*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
   <Grid Background="#080808" CornerRadius="12">
    <Image x:Name="RecordingImage" Stretch="Uniform" AutomationProperties.Name="当前录制画面"/>
    <StackPanel x:Name="PreviewPlaceholder" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False">
     <FontIcon Glyph="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{StaticResource TertiaryTextBrush}"/>
     <TextBlock Text="{Binding StatusTitle}" FontSize="16" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock x:Name="PreviewHint" Text="开始录制后显示采集画面" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Background="#C0181818" CornerRadius="5" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsHitTestVisible="False">
     <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="7" Height="7" Fill="{Binding Status,Converter={StaticResource RecordingStatusToBrushConverter}}" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusLabel}" FontSize="11"/></StackPanel>
    </Border>
    <TextBlock Text="录制预览" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" IsHitTestVisible="False"/>
   </Grid>

   <Border Grid.Row="1" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
     <Grid ColumnSpacing="20" RowSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="6"><TextBlock Text="采集画面" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}"/><TextBlock Text="{Binding CaptureSummary}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="编码" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}"/><TextBlock Text="{Binding EncoderSummary}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="声音" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}"/><TextBlock Text="{Binding AudioSummary}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6"><TextBlock Text="录制范围" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}"/><TextBlock Text="{Binding ClipWindowSummary}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
     </Grid>
    </ScrollViewer>
   </Border>
  </Grid>

  <Grid Grid.Column="1" RowSpacing="18">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Spacing="18">
   <StackPanel Spacing="12">
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="当前对局" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="{Binding FrameRate}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
    </Grid>
    <TextBlock Text="{Binding PlayerName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding BufferText}" FontSize="24" FontWeight="SemiBold"/>
    <ProgressBar Value="{Binding BufferPercent}" Maximum="100" AutomationProperties.Name="视频缓冲进度"/>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding BufferCapacityText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
     <TextBlock Grid.Column="1" Text="{Binding MemoryBudget}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
    </Grid>
   </StackPanel>

   <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
    <Grid RowSpacing="12" ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="CPU" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding CpuUsage}" FontSize="12"/>
     <TextBlock Grid.Row="1" Text="内存" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MemoryUsage}" FontSize="12"/>
     <TextBlock Grid.Row="2" Text="磁盘剩余" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiskFree}" FontSize="12"/>
     <TextBlock Grid.Row="3" Text="运行时长" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Uptime}" FontSize="12"/>
     <Button Grid.Row="4" Grid.ColumnSpan="2" Content="打开录像目录" Command="{Binding OpenOutputFolderCommand}" HorizontalAlignment="Stretch" FontSize="12" Padding="10,8"/>
    </Grid>
   </Border>

   <Border BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="运行动态" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
     <ListView Grid.Row="1" MaxHeight="180" ItemsSource="{Binding StateChanges}" SelectionMode="None" Background="Transparent" BorderThickness="0">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="0,8">
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="10" Foreground="{StaticResource TertiaryTextBrush}"/>
       </Grid>
       <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
      </StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
   </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="1" Spacing="10">
    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding StatusDetail}"/>
    <Button x:Name="StartRecordingButton" Content="开始录制" Click="Start_Click" HorizontalAlignment="Stretch" MinHeight="88"
            Padding="10" CornerRadius="12" FontSize="24" Style="{StaticResource PrimaryActionButtonStyle}"
            IsEnabled="{Binding CanToggleRecording}" Visibility="{Binding IsStartVisible,Converter={StaticResource BoolToVisibilityConverter}}"/>
    <Button Content="停止并保存" Command="{Binding StopCommand}" HorizontalAlignment="Stretch" MinHeight="88"
            Padding="10" CornerRadius="12" FontSize="20" Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" IsEnabled="{Binding CanToggleRecording}"
            Visibility="{Binding IsStopVisible,Converter={StaticResource BoolToVisibilityConverter}}"/>
   </StackPanel>
  </Grid>
  <InfoBar Grid.Row="1" Grid.ColumnSpan="2" IsOpen="{Binding HasWarning}" Message="{Binding WarningMessage}" Severity="Warning" IsClosable="False"/>
 </Grid>
</UserControl>

