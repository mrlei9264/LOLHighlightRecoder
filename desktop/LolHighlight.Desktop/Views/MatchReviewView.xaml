<UserControl x:Class="LolHighlight.Desktop.Views.MatchReviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:LolHighlight.Desktop.Controls">
 <Grid RowSpacing="12" ColumnSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="全选" Click="SelectAll_Click"/><Button Content="全不选" Click="ClearAll_Click"/></StackPanel>
  <GridView x:Name="VideoCards" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Video_ItemClick" SizeChanged="Cards_SizeChanged" Background="Transparent" AutomationProperties.Name="本局录像">
   <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></GridView.ItemContainerStyle>
   <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="218"/></ItemsPanelTemplate></GridView.ItemsPanel>
   <GridView.ItemTemplate><DataTemplate><Grid Margin="4" Padding="8" RowSpacing="6" Background="{StaticResource SurfaceBrush}" CornerRadius="8">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Background="Black" CornerRadius="5"><Image Stretch="Uniform" Loaded="Poster_Loaded" DataContextChanged="Poster_Changed" Unloaded="Poster_Unloaded"/></Grid>
    <CheckBox Grid.Row="1" IsChecked="{Binding Keep,Mode=TwoWay}" AutomationProperties.Name="{Binding Title}"><TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"/></CheckBox>
    <TextBlock Grid.Row="2" Text="{Binding Tags}" FontSize="11" Foreground="{StaticResource AccentLimeBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Tags}"/>
   </Grid></DataTemplate></GridView.ItemTemplate>
  </GridView>
  <Grid Grid.Column="1" Grid.RowSpan="2" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Background="Black" CornerRadius="8"><controls:MediaPreview x:Name="Preview" ControlsBelowVideo="True" AllowFullScreen="False"/></Grid>
   <TextBlock x:Name="PreviewTitle" Grid.Row="1" FontSize="12" TextTrimming="CharacterEllipsis"/>
  </Grid>
  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6"><TextBlock Text="仅保留勾选的录像" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DangerBrush}"/></StackPanel>
 </Grid>
</UserControl>
