<UserControl x:Class="LolHighlight.Desktop.Views.MatchReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LolHighlight.Desktop.Controls">
    <Grid RowSpacing="10" ColumnSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="58*" /><ColumnDefinition Width="42*" MinWidth="162" /></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox x:Name="EventFilter" MinWidth="106" MaxWidth="204" Height="34" DisplayMemberPath="Label"
                          SelectionChanged="Filter_Changed" AutomationProperties.Name="本局事件筛选" />
                <ToggleButton x:Name="ListMode" Content="列表" Height="34" Click="ViewMode_Click"
                              ToolTipService.ToolTip="切换卡片与列表" AutomationProperties.Name="列表视图" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="选中当前结果" Height="34" Click="SelectAll_Click" />
                <Button Content="取消当前选择" Height="34" Click="ClearAll_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="PreviewTitle" Text="录像预览" Style="{StaticResource LabelTextStyle}"
                           Margin="10,8" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="1">
                    <controls:MediaPreview x:Name="Preview" ControlsBelowVideo="True" AutomationProperties.Name="本局录像播放器" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource ListRowDividerStyle}" Padding="10,8">
                    <TextBlock x:Name="ReviewSummary" Text="本局片段" Style="{StaticResource LabelTextStyle}"
                               AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis" />
                </Border>
                <GridView x:Name="VideoCards" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Video_ItemClick"
                          SizeChanged="Cards_SizeChanged" Background="Transparent" AutomationProperties.Name="本局录像卡片">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="170" ItemHeight="154" /></ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4" Padding="5" RowSpacing="4" Background="{StaticResource PreviewSurfaceBrush}" CornerRadius="6">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Image Stretch="UniformToFill" Loaded="Poster_Loaded" DataContextChanged="Poster_Changed" Unloaded="Poster_Unloaded" />
                                <Grid Grid.Row="1" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Keep,Mode=TwoWay}" MinWidth="0" AutomationProperties.Name="{Binding Title}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Tags}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Tags}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <ListView x:Name="VideoRows" Grid.Row="1" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="Video_ItemClick" Background="Transparent" ItemContainerStyle="{StaticResource VideoListItemStyle}"
                          AutomationProperties.Name="本局录像列表">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRowDividerStyle}" Padding="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Keep,Mode=TwoWay}" MinWidth="0" AutomationProperties.Name="{Binding Title}" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Tags}" Style="{StaticResource MetaTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Tags}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock x:Name="KeepSummary" Style="{StaticResource LabelTextStyle}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="保存所选后，暂存项可从侧栏的「已丢弃录像」恢复。"
                       Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DangerBrush}" MaxLines="2"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</UserControl>
