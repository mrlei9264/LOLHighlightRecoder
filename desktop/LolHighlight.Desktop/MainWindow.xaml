<Window x:Class="LolHighlight.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LolHighlight.Desktop.Views"
        Title="Rift Replay">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <NavigationView x:Name="Navigation" PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="1000"
                        OpenPaneLength="176" CompactPaneLength="52"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        AlwaysShowHeader="False" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="录制" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavLibrary" Content="视频库" Tag="library">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavGrading" Content="调色" Tag="grading">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="10,4,8,12" Spacing="8">
                    <Button x:Name="PendingReviewShortcut" Click="ReviewPending_Click" Background="Transparent" BorderThickness="0" MinWidth="32" Height="34" Padding="7,0"
                            AutomationProperties.Name="待确认录像" ToolTipService.ToolTip="待确认录像">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                            <TextBlock x:Name="PendingReviewLabel" Text="待确认录像" VerticalAlignment="Center"
                                       Visibility="{Binding IsPaneOpen,ElementName=Navigation,Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                    <Button Click="ReviewDiscarded_Click" Background="Transparent" BorderThickness="0" MinWidth="32" Height="34" Padding="7,0"
                            AutomationProperties.Name="已丢弃录像" ToolTipService.ToolTip="查看和恢复已丢弃录像">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" FontSize="16" />
                            <TextBlock Text="已丢弃录像" VerticalAlignment="Center"
                                       Visibility="{Binding IsPaneOpen,ElementName=Navigation,Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecordingShortcut" Click="RecordingToggle_Click"
                            Background="Transparent" BorderThickness="0" MinWidth="32" Height="34" Padding="7,0"
                            IsEnabled="{Binding CanToggleRecording}"
                            AutomationProperties.Name="{Binding RecordingActionLabel}"
                            ToolTipService.ToolTip="{Binding RecordingActionLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C8;" FontSize="16" />
                            <TextBlock Text="{Binding RecordingActionLabel}"
                                       Visibility="{Binding IsPaneOpen,ElementName=Navigation,Converter={StaticResource BoolToVisibilityConverter}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" ToolTipService.ToolTip="{Binding WorkStatus}">
                        <Ellipse Width="7" Height="7" Fill="{Binding WorkStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WorkStatus}" Style="{StaticResource MetaTextStyle}"
                                   MaxWidth="126" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsPaneOpen,ElementName=Navigation,Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid>
                <views:HomePage x:Name="HomePageControl" />
                <views:LibraryPage x:Name="LibraryPageControl" Visibility="Collapsed" />
                <views:GradingPage x:Name="GradingPageControl" Visibility="Collapsed" />
                <views:SettingsPage x:Name="SettingsPageControl" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
        <Popup x:Name="FullScreenPopup">
            <Grid x:Name="FullScreenHost" Background="Black" />
        </Popup>
    </Grid>
</Window>
