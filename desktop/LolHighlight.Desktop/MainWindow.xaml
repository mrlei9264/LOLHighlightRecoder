<Window x:Class="LolHighlight.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:LolHighlight.Desktop.Views" Title="Rift Replay">
 <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="13*" MinWidth="168"/><ColumnDefinition Width="87*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,0,1,0">
   <Grid Padding="8,14,8,14" RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="BrandCopy" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><Image Source="ms-appx:///Assets/Brand.png" Width="26" Height="26"/><TextBlock Text="RIFT REPLAY" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
     <Button x:Name="CollapseNavigation" Grid.Column="1" Click="CollapseNavigation_Click" Padding="8" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="折叠 / 展开导航" AutomationProperties.Name="折叠或展开导航"><FontIcon Glyph="&#xE700;" FontSize="17"/></Button>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="6">
     <RadioButton x:Name="NavHome" GroupName="Navigation" Tag="home" Checked="Navigation_Checked" Style="{StaticResource NavigationItemStyle}" AutomationProperties.Name="录制" ToolTipService.ToolTip="录制"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7C8;" FontFamily="Segoe Fluent Icons" FontSize="17"/><TextBlock x:Name="HomeNavLabel" Text="录制" FontSize="13"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavLibrary" GroupName="Navigation" Tag="library" Checked="Navigation_Checked" Style="{StaticResource NavigationItemStyle}" AutomationProperties.Name="视频库" ToolTipService.ToolTip="视频库"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="17"/><TextBlock x:Name="LibraryNavLabel" Text="视频库" FontSize="13"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavGrading" GroupName="Navigation" Tag="grading" Checked="Navigation_Checked" Style="{StaticResource NavigationItemStyle}" AutomationProperties.Name="调色" ToolTipService.ToolTip="调色"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="17"/><TextBlock x:Name="GradingNavLabel" Text="调色" FontSize="13"/></StackPanel></RadioButton>
     <RadioButton x:Name="NavSettings" GroupName="Navigation" Tag="settings" Checked="Navigation_Checked" Style="{StaticResource NavigationItemStyle}" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17"/><TextBlock x:Name="SettingsNavLabel" Text="设置" FontSize="13"/></StackPanel></RadioButton>
    </StackPanel>
    <StackPanel Grid.Row="3" Spacing="12">
     <Button Click="RecordingToggle_Click" HorizontalAlignment="Stretch" Padding="8" IsEnabled="{Binding CanToggleRecording}" ToolTipService.ToolTip="{Binding RecordingActionLabel}" AutomationProperties.Name="{Binding RecordingActionLabel}"><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><FontIcon Glyph="&#xE7C8;" FontSize="16"/><TextBlock x:Name="RecordNavLabel" Text="{Binding RecordingActionLabel}" FontSize="12"/></StackPanel></Button>
     <Grid ColumnSpacing="8" Margin="8,0" ToolTipService.ToolTip="{Binding WorkStatus}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Ellipse x:Name="SidebarStatusDot" Width="7" Height="7" Fill="{Binding WorkStatusColor}" VerticalAlignment="Center"/>
      <TextBlock x:Name="SidebarWorkStatus" Grid.Column="1" Text="{Binding WorkStatus}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}"/>
     </Grid>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><views:HomePage x:Name="HomePageControl"/><views:LibraryPage x:Name="LibraryPageControl" Visibility="Collapsed"/><views:GradingPage x:Name="GradingPageControl" Visibility="Collapsed"/><views:SettingsPage x:Name="SettingsPageControl" Visibility="Collapsed"/></Grid>
  <Grid x:Name="FullScreenHost" Grid.ColumnSpan="2" Background="Black" Visibility="Collapsed"/>
 </Grid>
</Window>
