<Application x:Class="LolHighlight.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:LolHighlight.Desktop.Converters"
             RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:RecordingStatusToBrushConverter x:Key="RecordingStatusToBrushConverter" />
            <converters:BoolToInfoBarSeverityConverter x:Key="BoolToInfoBarSeverityConverter" />

            <Thickness x:Key="PagePadding">24,18,24,18</Thickness>
            <Thickness x:Key="PanelPadding">16</Thickness>
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="ListViewItemCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ComboBoxItemCornerRadius">6</CornerRadius>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#26282B" />
            <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#191919" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#393939" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CCCCCC" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#ACACAC" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F7D078" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF9A9D" />
            <SolidColorBrush x:Key="ChapterMarkerBrush" Color="{ThemeResource SystemAccentColorLight2}" />

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="StatusHeadingTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MetaTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="QuietPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
            </Style>
            <Style x:Key="ListRowDividerStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <Style x:Key="VideoListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <Style x:Key="RecorderTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="34" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
