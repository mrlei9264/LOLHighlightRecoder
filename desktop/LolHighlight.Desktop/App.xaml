<Application
    x:Class="LolHighlight.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LolHighlight.Desktop.Converters"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:RecordingStatusToBrushConverter x:Key="RecordingStatusToBrushConverter"/>
            <converters:BoolToInfoBarSeverityConverter x:Key="BoolToInfoBarSeverityConverter"/>

            <!-- 基础色板 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#151515" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#282828" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#303030" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#383838" />
            <SolidColorBrush x:Key="StrongStrokeBrush" Color="#555555" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C2C2C2" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="AccentLimeBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="AccentLimeHoverBrush" Color="#98DEFF" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#00324A" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#153A4B" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F2C94C" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F07178" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#2A171A" />

            <LinearGradientBrush x:Key="AppBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#151515" Offset="0" />
                <GradientStop Color="#0C141D" Offset="0.55" />
                <GradientStop Color="#101D28" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1B3439" Offset="0" />
                <GradientStop Color="#17242D" Offset="0.52" />
                <GradientStop Color="#121D27" Offset="1" />
            </LinearGradientBrush>

            <!-- 覆盖系统强调色，让进度条、输入框、开关与界面配色一致 -->
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#60CDFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4A5A4C" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1A2228" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#202A30" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#153A4B" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1D4A60" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#245D76" />
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#F3F3F3" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#153A4B" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#1D4A60" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#245D76" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#F3F3F3" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#60CDFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#98DEFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#46A8D5" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#60CDFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#98DEFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#46A8D5" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#00324A" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#C2C2C2" />

            <!-- 字体层级 -->
            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>

            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="30" />
                <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            </Style>

            <!-- 卡片 -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="SubtleCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Background" Value="#191919" />
            </Style>

            <Style x:Key="ChipBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="#2D514B" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="9,4" />
            </Style>

            <!-- 按钮 -->
            <ControlTemplate x:Key="ActionButtonTemplate" TargetType="Button">
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="Presenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.88" Duration="0:0:0.08" />
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.72" Duration="0:0:0.06" />
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.4" Duration="0:0:0.08" />
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Border>
            </ControlTemplate>

            <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />

            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
                <Setter Property="Background" Value="{StaticResource AccentLimeBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrongStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
                <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                <Setter Property="BorderBrush" Value="#4A272C" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- 侧栏导航 -->
            <Style x:Key="NavigationItemStyle" TargetType="RadioButton">
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="11">
                                <Grid>
                                    <Border Background="{StaticResource AccentSubtleBrush}"
                                            CornerRadius="11"
                                            Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Border x:Name="Indicator"
                                            Width="3" Height="18" CornerRadius="2"
                                            Background="{StaticResource AccentLimeBrush}"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <ContentPresenter x:Name="Presenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Margin="16,10,14,10"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SurfaceHoverBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Presenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PrimaryTextBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SurfaceRaisedBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 输入控件 -->
            <Style x:Key="RecorderTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrongStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource TertiaryTextBrush}" />
            </Style>

            <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrongStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="NumberBoxStyle" TargetType="NumberBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrongStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            </Style>

            <Style x:Key="VideoListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
